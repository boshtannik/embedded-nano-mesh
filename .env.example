# embedded-nano-mesh compile-time configuration
#
# Copy this file to `.env` and adjust the values, or export the same
# variables in your shell environment. Real environment variables take
# precedence over the `.env` file.
#
# All variables are optional — the library falls back to sane defaults.

# Duplicate filter: how long (in ms) a packet id is remembered and
# duplicates are ignored. Default: 1000
ENM_RECEIVER_FILTER_DUPLICATE_IGNORE_PERIOD=1000

# Duplicate filter: how many packet ids can be remembered at once.
# Default: 8
ENM_RECEIVER_FILTER_REGISTRATION_SIZE=8

# Duplicate filter: what to do when the registration table is full.
#   evict_oldest - drop the oldest entry and accept the new packet (default)
#   drop_new     - reject the new packet and keep existing entries
ENM_RECEIVER_FILTER_OVERFLOW_STRATEGY=evict_oldest

# Duplicate filter: what to do when a duplicate of an already-known
# packet is detected.
#   ignore        - ignore the duplicate and leave the period unchanged
#   double_period - ignore the duplicate and double the ignore period
#                   (simple anti-flood backoff, default)
ENM_RECEIVER_FILTER_DUPLICATE_STRATEGY=double_period

# Size of the packet payload in bytes. Default: 32
ENM_PACKET_DATA_LENGTH=32

# Size of the packet queues (received, send and transit). Default: 5
ENM_PACKET_QUEUE_SIZE=5

# Size of the device address (and lifetime) wire type in bytes.
#  1 - u8  (255 addresses, max 255 hops, default)
#  2 - u16 (65535 addresses, max 65535 hops)
#  4 - u32 (4 billion addresses, max 4 billion hops)
# Note: any value other than 1 breaks wire compatibility with the
# default (u8) build.
ENM_ADDRESS_BYTES=1
